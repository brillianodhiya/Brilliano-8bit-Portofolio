{
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "panels": [], "title": "🌍 Website Health (Synthetics)", "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 100 } ] }, "unit": "percent" } },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 1 }, "id": 101, "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "mean" ] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg_over_time(sm_check_status{job=\"Pixel Portfolio Heartbeat\"}[$__range]) * 100", "refId": "A" } ],
      "title": "Global Uptime", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }, "unit": "s" } },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 }, "id": 102, "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": [ "mean" ] } },
      "targets": [ { "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "avg(sm_check_duration_seconds{job=\"Pixel Portfolio Heartbeat\"})", "refId": "A" } ],
      "title": "Mean Latency (Global)", "type": "stat"
    },
    {
      "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }, "id": 200, "panels": [], "title": "📈 Visitor Traffic (Supabase)", "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "short" } },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 9 }, "id": 1, "options": { "colorMode": "value", "reduceOptions": { "calcs": [ "lastNotNull" ] } },
      "targets": [ { "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "format": "table", "sql": "SELECT SUM(count) as total FROM portfolio_page_visits" } ],
      "title": "Total Visitors", "type": "stat"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 9 }, "id": 2, "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [ { "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" }, "format": "time_series", "sql": "SELECT count, date as time FROM portfolio_activity_log WHERE date > now() - interval '90 days' ORDER BY time ASC" } ],
      "title": "Daily Coding Activity", "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      { "label": "DB Source", "name": "DS_POSTGRES", "query": "postgres", "refresh": 1, "type": "datasource" },
      { "label": "Metrics Source", "name": "DS_PROMETHEUS", "query": "prometheus", "refresh": 1, "type": "datasource" }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Pixel Portfolio Master Dashboard V4_1",
  "version": 1
}
